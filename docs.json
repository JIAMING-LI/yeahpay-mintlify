{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "yeahpay-api",
  "colors": {
    "primary": "#0055FF",
    "light": "#0061FF",
    "dark": "#576DFF"
  },
  "favicon": "/favicon.png",
  "navigation": {
    "languages": [
      {
        "language": "zh-CN",
        "default": true,
        "tabs": [
          {
            "tab": "快速开始",
            "groups": [
              {
                "group": "接入指南",
                "pages": [
                  "index",
                  "signature",
                  "api-tester"
                ]
              }
            ]
          },
          {
            "tab": "产品介绍",
            "groups": [
              {
                "group": "支付产品",
                "pages": [
                  "unified-checkout",
                  "embedded-checkout",
                  "payment-link"
                ]
              },
              {
                "group": "API",
                "pages": [
                  "embedded-checkout-sdk"
                ]
              }
            ]
          },
          {
            "tab": "API文档",
            "openapi": {
              "source": "openapi.json",
              "directory": "api-reference"
            }
          }
        ]
      },
      {
        "language": "zh-Hant",
        "tabs": [
          {
            "tab": "快速開始",
            "groups": [
              {
                "group": "接入指南",
                "pages": [
                  "zh-hk/index",
                  "zh-hk/signature",
                  "zh-hk/api-tester"
                ]
              }
            ]
          },
          {
            "tab": "產品介紹",
            "groups": [
              {
                "group": "支付產品",
                "pages": [
                  "zh-hk/unified-checkout",
                  "zh-hk/embedded-checkout",
                  "zh-hk/payment-link"
                ]
              },
              {
                "group": "API",
                "pages": [
                  "zh-hk/embedded-checkout-sdk"
                ]
              }
            ]
          },
          {
            "tab": "API文件",
            "openapi": {
              "source": "openapi-zh-hk.json",
              "directory": "zh-hk/api-reference"
            }
          }
        ]
      },
      {
        "language": "en",
        "tabs": [
          {
            "tab": "Get Started",
            "groups": [
              {
                "group": "Integration guide",
                "pages": [
                  "en/index",
                  "en/signature",
                  "en/api-tester"
                ]
              }
            ]
          },
          {
            "tab": "Product Description",
            "groups": [
              {
                "group": "Payment products",
                "pages": [
                  "en/unified-checkout",
                  "en/embedded-checkout",
                  "en/payment-link"
                ]
              },
              {
                "group": "API",
                "pages": [
                  "en/embedded-checkout-sdk"
                ]
              }
            ]
          },
          {
            "tab": "API reference",
            "openapi": {
              "source": "openapi-en.json",
              "directory": "en/api-reference"
            }
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/yeahpay.png",
    "dark": "/logo/yeahpay.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hi@mintlify.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  },
  "redirects": [
    {
      "source": "/h5-checkout",
      "destination": "/unified-checkout"
    },
    {
      "source": "/pc-checkout",
      "destination": "/unified-checkout"
    },
    {
      "source": "/en/h5-checkout",
      "destination": "/en/unified-checkout"
    },
    {
      "source": "/en/pc-checkout",
      "destination": "/en/unified-checkout"
    },
    {
      "source": "/api-reference/嵌入式收银台/创建嵌入式支付意图",
      "destination": "/api-reference/支付意图/创建支付意图"
    },
    {
      "source": "/api-reference/嵌入式收银台/查询嵌入式支付状态",
      "destination": "/api-reference/支付意图/查询支付意图"
    },
    {
      "source": "/en/api-reference/embedded-checkout/create-embedded-paymentintent",
      "destination": "/en/api-reference/payment-intents/create-paymentintent"
    },
    {
      "source": "/en/api-reference/embedded-checkout/query-embedded-payment-status",
      "destination": "/en/api-reference/payment-intents/query-paymentintent"
    }
  ],
  "api": {
    "playground": {
      "url": "full"
    }
  }
}
